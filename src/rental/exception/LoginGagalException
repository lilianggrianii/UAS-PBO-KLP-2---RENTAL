package rental.exception;

/** Dilempar ketika username atau password yang dimasukkan salah. */
public class LoginGagalException extends RentalException {

    /** Membuat exception dengan pesan standar login gagal. */
    public LoginGagalException() {
        super("Username atau password salah.");
    }

    /**
     * Membuat exception dengan pesan khusus (misalnya peran akun tidak sesuai pilihan).
     *
     * @param pesan penjelasan penyebab login gagal
     */
    public LoginGagalException(String pesan) {
        super(pesan);
    }
}

