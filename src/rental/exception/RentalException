package rental.exception;

/**
 * Exception dasar untuk seluruh kesalahan yang terjadi di sistem rental.
 * Semua exception khusus aplikasi ini mewarisi class ini, sehingga
 * cukup ditangkap dengan satu blok catch di menu.
 */
public class RentalException extends Exception {

    /**
     * @param pesan pesan kesalahan yang akan ditampilkan ke pengguna
     */
    public RentalException(String pesan) {
        super(pesan);
    }
}

